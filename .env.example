ANTHROPIC_API_KEY=
DATABASE_URL=postgres://simbe:simbe@localhost:5434/simbe_development
SECRET_KEY_BASE=
# Frontend API mode (docs/superpowers/specs/2026-10/2026-10-14-2101): `real` (default) talks to the
# Rails API on the same origin; `mock` starts MSW inside the Rails dev server instead. The standalone
# mock host (`npm run dev:mock`) is always `mock` (vite.mock.config.ts forces it) and needs no Rails.
VITE_API_MODE=real
# Rails Active Record encryption (screener health answers). Required in production; tests and local
# development fall back to fixed, non-secret keys when these are blank (fictional data only). Generate
# your own with `bin/rails db:encryption:init` (wire the two values below).
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
