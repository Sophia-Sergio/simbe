#!/usr/bin/env python3
"""Helper for running many agents on the parallel lane plans.

  bin/lane list                         lanes, waves, plans
  bin/lane start F-WEEK [--slug x]      worktree + branch + isolated docker env + agent prompt
  bin/lane check [--lane ID]            ownership check (files changed vs base must be inside the lane's Owns)
  bin/lane pr [--draft|--no-auto-merge]  check, push, open the PR, post the claude-review status, enable auto-merge
  bin/lane run F-WEEK [--model m]       hand the lane to OpenCode headlessly (locked-down permissions, no push)
  bin/lane watchdog [--minutes 15]      flag running lanes whose OpenCode run is stalled (log quiet) or dead (no process); exit 7 if any
  bin/lane canary                       prove OpenCode's gated permissions are enforced (scratch repo, local bare remote)
  bin/lane review F-WEEK                independent evidence report for the lane branch (the review gate)
  bin/lane approve F-WEEK               reviewer records approval for the exact HEAD after verification + review (required by `pr`)
  bin/lane status                       who is doing what (branches/PRs from GitHub)
  bin/lane graph [--file F --write|--check]   dependency diagram + table generated from the plans' 'Depends on' lines
  bin/lane stop F-WEEK                  tear down the worktree's docker stack and remove the worktree
  bin/lane next [--json] [--assume-merged IDS] [--limit N]   lanes that may start now (conductor)
  bin/lane state show|set|set-caps|set-models …              conductor state (.superpowers/orchestrator/state.json or $LANE_STATE)
  bin/lane ci F-WEEK                    wait for the PR checks; print failing job logs
  bin/lane rebase F-WEEK                rebase the lane on origin/main and print a range-diff

Guide: docs/superpowers/parallel/playbook.md
"""
import argparse, contextlib, fcntl, os, re, subprocess, sys, glob, json, tempfile, time, datetime

def sh(*cmd, cwd=None, check=True, capture=True):
    r = subprocess.run(cmd, cwd=cwd, text=True, capture_output=capture)
    if check and r.returncode != 0:
        sys.exit(f"command failed: {' '.join(cmd)}\n{r.stderr or r.stdout}")
    return (r.stdout or "").strip() if capture else ""

ROOT = sh("git", "rev-parse", "--show-toplevel")
COMMON = os.path.realpath(os.path.join(ROOT, sh("git", "-C", ROOT, "rev-parse", "--git-common-dir")))
MAIN_ROOT = os.path.dirname(COMMON)
PLANS = os.path.join(ROOT, "docs/superpowers/plans/2026-10")

def expand(g):
    m = re.search(r"\{([^{}]*)\}", g)
    if not m:
        return [g]
    return [x for part in m.group(1).split(",") for x in expand(g[:m.start()] + part + g[m.end():])]

def glob_re(g):
    out, i = "", 0
    while i < len(g):
        if g.startswith("**/", i): out += "(?:.*/)?"; i += 3
        elif g.startswith("**", i): out += ".*"; i += 2
        elif g[i] == "*": out += "[^/]*"; i += 1
        elif g[i] == "?": out += "[^/]"; i += 1
        else: out += re.escape(g[i]); i += 1
    return re.compile("^" + out + "$")

def lanes():
    found = {}
    for path in sorted(glob.glob(os.path.join(PLANS, "*.md"))):
        text = open(path).read()
        lane = re.search(r"^\*\*Lane:\*\*\s+(\S+)", text, re.M)
        if not lane:
            continue
        wave = re.search(r"\*\*Wave:\*\*\s+(\d)", text)
        owns = re.search(r"^\*\*Owns:\*\*(.*)$", text, re.M)
        dep = re.search(r"^\*\*Depends on \(merged\):\*\*(.*)$", text, re.M)
        title = text.splitlines()[0].lstrip("# ").strip()
        found[lane.group(1)] = dict(id=lane.group(1), path=path, dep=dep.group(1).strip() if dep else "", rel=os.path.relpath(path, ROOT),
            wave=int(wave.group(1)) if wave else 0, title=title,
            owns=[x for g in re.findall(r"`([^`]+)`", owns.group(1) if owns else "") for x in expand(g)],
            slug=re.sub(r"^\d{4}-\d{2}-\d{2}-\d{4}-", "", os.path.basename(path)[:-3]))
    return found

def get_lane(lane_id):
    ls = lanes()
    key = next((k for k in ls if k.lower() == lane_id.lower()), None)
    if not key:
        sys.exit(f"unknown lane {lane_id!r}; try: bin/lane list")
    return ls[key]

def current_lane():
    branch = sh("git", "branch", "--show-current")
    m = re.match(r"lane/([A-Za-z0-9-]+?)-[a-z0-9]", branch)
    cands = [k for k in lanes() if branch.startswith(f"lane/{k}-")]
    if not cands:
        sys.exit(f"cannot infer the lane from branch {branch!r} (expected lane/<LANE-ID>-<slug>); pass --lane")
    return max(cands, key=len)

PROMPT = """Implement `@{rel}`.

Read first: the plan, the spec it links, every file in `docs/conventions/`, `docs/design/brand.md` and
`docs/superpowers/parallel/README.md` ({rules}).
Touch ONLY the files in the plan's `Owns` list. Follow the plan's overrides to its "detail reference" tasks exactly.
Commit after each task with the message pattern in the plan. Before opening a PR run the plan's "Done when" commands,
`make verify` and `bin/lane check`; then `bin/lane pr`. Paste command outputs and desktop+mobile screenshots in the PR.
Your docker stack is isolated (see `make ports`); never touch other worktrees' stacks.
Stop and ask if blocked, or if a needed change is outside your lane (file a Contract Change Request or ask for an ownership change)."""

def prompt_for(l):
    rules = "frontend lane rules" if l["id"].startswith("F-") else "backend lane rules" if l["id"].startswith("B-") else "lane rules"
    return PROMPT.format(rel=l["rel"], rules=rules)

def cmd_list(a):
    print(f"{'LANE':<14}{'WAVE':<6}PLAN")
    for l in sorted(lanes().values(), key=lambda x: (x["wave"], x["id"])):
        print(f"{l['id']:<14}{l['wave']:<6}{l['rel']}")

def cmd_start(a):
    l = get_lane(a.lane)
    slug = a.slug or l["slug"].replace("lane-", "").replace(l["id"].lower() + "-", "")[:40]
    branch = f"lane/{l['id']}-{slug}"
    path = os.path.join(MAIN_ROOT, ".worktrees", l["id"].lower())
    steps = [["git", "fetch", "origin"],
             ["git", "worktree", "add", path, "-b", branch, a.base]]
    for s in steps:
        print("$", " ".join(s))
        if not a.dry_run:
            sh(*s, cwd=MAIN_ROOT)
    print(f"$ (cd {path} && bin/worktree-env)")
    if not a.dry_run:
        if not os.path.exists(os.path.join(MAIN_ROOT, ".env")):
            sys.exit("no .env in the main checkout; copy .env.example and set ANTHROPIC_API_KEY first")
        sh("bash", os.path.join(path, "bin/worktree-env"), cwd=path)
        open(os.path.join(path, ".lane-prompt.md"), "w").write(prompt_for(l) + "\n")
    print(f"\nLane {l['id']} (wave {l['wave']}) -> {path}\nBranch: {branch}\n")
    print("Next: open that folder in Cursor, or `cd` there and run `opencode` / `claude`; paste:\n")
    print(prompt_for(l))

def changed_files(base):
    tracked = sh("git", "diff", "--name-only", base).splitlines()
    untracked = sh("git", "ls-files", "--others", "--exclude-standard").splitlines()
    return sorted(set(tracked + untracked))

def cmd_check(a):
    lid = a.lane or current_lane()
    l = get_lane(lid)
    labels = os.environ.get("PR_LABELS", "") + (" ccr" if a.ccr else "")
    pats = [glob_re(g) for g in l["owns"]]
    bad = []
    for f in changed_files(a.base):
        if any(p.match(f) for p in pats): continue
        if f == l["rel"]: continue                                   # own plan checkboxes
        if "ccr" in labels and (f.startswith("contracts/") or f.startswith("app/javascript/api/generated/")): continue
        bad.append(f)
    if bad:
        print(f"OUTSIDE LANE {l['id']}:")
        for f in bad: print("  ", f)
        sys.exit(1)
    print(f"ok: all changes are inside lane {l['id']}")

def cmd_pr(a):
    l = get_lane(a.lane or current_lane())
    state = load_state()  # a corrupt state file must stop us BEFORE anything is published
    wt = os.path.join(MAIN_ROOT, ".worktrees", l["id"].lower()); top = os.path.realpath(sh("git", "rev-parse", "--show-toplevel"))
    if os.path.isdir(wt) and top != os.path.realpath(wt): sys.exit(f"gate: run this from the lane's worktree ({wt}); you are in {top}")
    rec = state["lanes"].get(l["id"], {})
    if rec.get("phase") in ("running", "fixing"): sys.exit(f"gate: {l['id']} is in phase {rec['phase']!r}; wait for the run to finish, then verify, review and approve again before publishing")
    branch = sh("git", "branch", "--show-current")
    if not branch: sys.exit("gate: detached HEAD; check out the lane branch first")
    sha = sh("git", "rev-parse", "HEAD")  # pinned: the approval check, the push and the claude-review status below all act on this commit
    if not a.skip_gate: require_approval(l, sha)
    cmd_check(argparse.Namespace(lane=l["id"], base=a.base, ccr=False))
    if a.dry_run:
        print("dry run: would push, open or update the PR, post the `claude-review` status on the reviewed commit" + (" and enable auto-merge (squash)" if a.auto_merge else "")); return
    existing = open_pr_for(branch)
    if existing:
        # A fix round or a rebase after approval: update the same PR. The lease names the head this tool last published, so a commit pushed by
        # someone else is never overwritten (a plain --force-with-lease is defeated by any `git fetch`, which rebase and start both run).
        leased = rec.get("head")
        if not leased: sys.exit(f"gate: no recorded published head for {l['id']}; set it first: bin/lane state set {l['id']} head=<sha of the PR's current head>")
        sh("git", "push", f"--force-with-lease=refs/heads/{branch}:{leased}", "origin", f"{sha}:refs/heads/{branch}", capture=False)
        url = existing["url"]; print(f"updated {url}")
    else:
        merged = json.loads(sh("gh", "pr", "list", "--head", branch, "--state", "merged", "--json", "url") or "[]")
        if merged: sys.exit(f"gate: {l['id']} already merged ({merged[0]['url']}); nothing to publish")
        sh("git", "push", "origin", f"{sha}:refs/heads/{branch}", capture=False)
        sh("git", "branch", "--set-upstream-to", f"origin/{branch}", check=False)
        body = f"""## Lane {l['id']} (wave {l['wave']})

Plan: `{l['rel']}`

## Checklist (paste outputs below)
- [ ] The plan's **Done when** commands pass (outputs pasted)
- [ ] `make verify` is green
- [ ] `bin/lane check` is clean (only files in the plan's `Owns` list changed)
- [ ] Desktop (1280x800) and mobile (390x844) screenshots attached and compared with the design handoff and `docs/design/brand.md` (UI lanes)
- [ ] No contract change needed (otherwise a separate `ccr` PR)

## Outputs / screenshots
"""
        for lab, col in (("lane", "0E8A16"), (f"wave-{l['wave']}", "1D76DB")):
            sh("gh", "label", "create", lab, "--color", col, check=False)
        cmd = ["gh", "pr", "create", "--base", "main", "--title", f"{l['id']}: {l['title'].split(' — ')[0]}", "--body", body, "--label", f"lane,wave-{l['wave']}"]
        if a.draft: cmd.append("--draft")
        url = sh(*cmd); print(url)
    # The reviewer's approval is bound to the exact commit: publish it as the `claude-review` commit status that branch protection requires.
    repo = sh("gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner")
    ap = json.load(open(os.path.join(gate_dir(l), "approved.json"))) if os.path.exists(os.path.join(gate_dir(l), "approved.json")) else {}
    sh("gh", "api", "-X", "POST", f"repos/{repo}/statuses/{sha}", "-f", "state=success", "-f", "context=claude-review",
       "-f", f"description=reviewed by {ap.get('by', 'reviewer')} (independent verification + code review)"[:140])
    print(f"posted claude-review=success on {sha[:9]}")
    auto = False
    if a.auto_merge and not a.draft:
        r = subprocess.run(["gh", "pr", "merge", url, "--auto", "--squash"], text=True, capture_output=True)
        auto = r.returncode == 0
        print("auto-merge enabled (merges when the required checks are green)" if auto else "auto-merge not enabled: " + (r.stderr or r.stdout).strip()[:200])
    # `ci` means the PR is open with auto-merge on; otherwise it is approved and waiting for a human to merge.
    safe_update(l["id"], phase="ci" if auto else "approved", pr=url, head=sha)

def lane_states(ls):
    """lane -> (state, link) from GitHub: merged / PR open / draft PR / in progress / not started."""
    prs = json.loads(sh("gh", "pr", "list", "--state", "all", "--limit", "300", "--json", "headRefName,state,url,isDraft") or "[]")
    heads = sh("git", "ls-remote", "--heads", "origin", "lane/*").splitlines()
    branches = [h.split("refs/heads/")[1] for h in heads if "refs/heads/" in h]
    out = {}
    for k in ls:
        pre = f"lane/{k}-"
        mine = [p for p in prs if p["headRefName"].startswith(pre)]
        if any(p["state"] == "MERGED" for p in mine): out[k] = ("merged", next(p["url"] for p in mine if p["state"] == "MERGED"))
        elif any(p["state"] == "OPEN" for p in mine):
            p = next(p for p in mine if p["state"] == "OPEN"); out[k] = ("draft PR" if p["isDraft"] else "PR open", p["url"])
        elif any(b.startswith(pre) for b in branches): out[k] = ("in progress", next(b for b in branches if b.startswith(pre)))
        else: out[k] = ("not started", "")
    return out

def cmd_status(a):
    ls = lanes(); st = lane_states(ls)
    print(f"{'LANE':<14}{'WAVE':<6}{'STATE':<16}LINK")
    for l in sorted(ls.values(), key=lambda x: (x["wave"], x["id"])):
        state, link = st[l["id"]]
        print(f"{l['id']:<14}{l['wave']:<6}{state:<16}{link}")

SHORT = {"W0-1": "Rails scaffold", "W0-2": "Contract tooling + mocks", "W0-3": "Backend core", "W0-4A": "UI kit primitives", "W0-4B": "UI kit data-viz",
  "W0-5": "App core", "W0-6A": "Desktop shell", "W0-6B": "Mobile shell", "W0-7": "CI/CD + deploy",
  "B-INGEST": "Ingest", "B-METRICS": "Metrics", "B-LEADS": "Leads", "B-ACTIONS": "Next actions", "B-ACCOUNT": "Account", "B-AGENT": "Agent", "B-MCP": "MCP",
  "F-WEEK": "This week", "F-FUNNEL": "Funnel", "F-CHANNELS": "Channels", "F-PIPELINE": "Pipeline", "F-LEADPANEL": "Lead panel", "F-NEXTACTIONS": "Next actions UI",
  "F-COORDINATORS": "Coordinators", "F-SEARCH": "Search", "F-SIGNUP": "Sign-up", "F-DATA": "Data sources", "F-SETTINGS": "Settings", "F-AGENT": "Ask Simbe", "F-CONNECT": "Connect Claude",
  "W3-1": "Integration", "W3-2": "E2E journeys", "W3-3": "Mobile/brand audit"}
FRONT_SUBSTRATE = ["W0-1", "W0-2", "W0-4A", "W0-4B", "W0-5", "W0-6A", "W0-6B"]

def direct_deps(ls):
    """lane -> set of lane ids it declares as prerequisites ('Wave 0' means the frontend substrate for F-* lanes)."""
    out = {}
    for k, l in ls.items():
        t, d = l["dep"], set()
        for o in ls:
            if o != k and re.search(r"(?<![\w-])" + re.escape(o) + r"(?![\w-])", t): d.add(o)
        if re.search(r"all Wave 0, Wave 1 and Wave 2", t): d |= {o for o in ls if ls[o]["wave"] < 3}
        elif "Wave 0" in t and k.startswith("F-"): d |= set(FRONT_SUBSTRATE)
        out[k] = d
    return out

def reduce_deps(deps):
    def reach(a, b, skip):
        seen, stack = set(), [x for x in deps[a] if (a, x) != skip]
        while stack:
            n = stack.pop()
            if n == b: return True
            if n in seen: continue
            seen.add(n); stack += list(deps[n])
        return False
    red = {k: set(v) for k, v in deps.items()}
    for a in deps:
        for b in list(deps[a]):
            if any(c != b and reach(c, b, None) for c in deps[a]): red[a].discard(b)
    return red

def mermaid(ls):
    red = reduce_deps(direct_deps(ls))
    wave_title = {0: "Wave 0 - substrate", 1: "Wave 1 - parallel lanes", 2: "Wave 2", 3: "Wave 3 - integration"}
    lines = ["flowchart LR"]
    for w in (0, 1, 2, 3):
        members = sorted(k for k in ls if ls[k]["wave"] == w)
        lines.append(f'  subgraph W{w}["{wave_title[w]}"]')
        for k in members: lines.append(f'    {k.replace("-", "_")}["{k}<br/>{SHORT.get(k, k)}"]')
        lines.append("  end")
    gate_fe, gate_be, gate_all = "FE_GATE", "BE_GATE", "ALL_GATE"
    lines += [f'  {gate_fe}(["frontend substrate merged<br/>W0-6A + W0-6B"])', f'  {gate_be}(["backend core merged<br/>W0-3"])', f'  {gate_all}(["every Wave 0-2 lane merged"])']
    used = set()
    def node(x): return x.replace("-", "_")
    for k in sorted(ls):
        d = red[k]
        if d == {"W0-6A", "W0-6B"}: lines.append(f"  {gate_fe} --> {node(k)}"); used.add(gate_fe)
        elif d == {"W0-3"}: lines.append(f"  {gate_be} --> {node(k)}"); used.add(gate_be)
        elif len(d) >= 8: lines.append(f"  {gate_all} --> {node(k)}"); used.add(gate_all)
        else:
            for x in sorted(d): lines.append(f"  {node(x)} --> {node(k)}")
    for g, members in ((gate_fe, ["W0-6A", "W0-6B"]), (gate_be, ["W0-3"])):
        if g in used:
            for m in members: lines.append(f"  {node(m)} --> {g}")
    if gate_all in used:
        dependents = {x for d in red.values() for x in d}
        leaves = sorted(k for k in ls if ls[k]["wave"] < 3 and not any(k in red[o] for o in ls if o != k and not (len(red[o]) >= 8)))
        for m in leaves: lines.append(f"  {node(m)} --> {gate_all}")
    return "\n".join(lines)

def table(ls):
    red, full = reduce_deps(direct_deps(ls)), direct_deps(ls)
    rows = ["| Lane | Wave | Needs merged first (direct) | Unblocks (direct) |", "|---|---|---|---|"]
    for k in sorted(ls, key=lambda x: (ls[x]["wave"], x)):
        needs = ", ".join(sorted(red[k])) or "-"
        if len(red[k]) >= 8: needs = "every Wave 0-2 lane"
        elif red[k] == {"W0-6A", "W0-6B"}: needs = "W0-6A, W0-6B (frontend substrate)"
        unlocks = sorted(o for o in ls if k in red[o])
        rows.append(f"| {k} {SHORT.get(k, '')} | {ls[k]['wave']} | {needs} | {', '.join(unlocks) if len(unlocks) < 8 else str(len(unlocks)) + ' lanes (' + ', '.join(unlocks[:3]) + ', ...)'} |")
    return "\n".join(rows)

def cmd_graph(a):
    ls = lanes()
    block = "```mermaid\n" + mermaid(ls) + "\n```\n\n" + table(ls) + "\n"
    if not a.file: print(block); return
    doc = open(a.file).read()
    m = re.search(r"(<!-- graph:start -->\n).*?(<!-- graph:end -->)", doc, re.S)
    if not m: sys.exit(f"{a.file}: missing <!-- graph:start --> / <!-- graph:end --> markers")
    new = doc[:m.start()] + m.group(1) + block + m.group(2) + doc[m.end():]
    if a.check:
        print("dependency graph is up to date" if new == doc else "dependency graph is STALE: run bin/lane graph --file " + a.file + " --write")
        sys.exit(0 if new == doc else 1)
    if a.write: open(a.file, "w").write(new); print("updated", a.file)
    else: print(block)

# ---------------------------------------------------------------- review gate (see docs/superpowers/parallel/review-gate.md)
GATE_ROOT = os.path.join(MAIN_ROOT, ".superpowers", "gate")
RED_FLAGS = [
    ("skipped/focused test", r"(\bit\.skip|\bxit\(|\bxdescribe|describe\.skip|test\.skip|\.only\(|(?:^|;)\s*pending\s*(?:\(|[\"'])|\bskip\b\s*[\"'(:])"),
    ("TODO/FIXME/HACK", r"\b(TODO|FIXME|HACK|XXX)\b"),
    ("debug leftovers", r"(console\.log\(|binding\.pry|byebug|\bdebugger\b|\bputs\s+[\"'#])"),
    ("secret-looking value", r"(sk-ant-[A-Za-z0-9_-]{10,}|AKIA[0-9A-Z]{12,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)"),
    ("browser storage", r"(localStorage|sessionStorage)"),
    ("unsafe HTML", r"dangerouslySetInnerHTML"),
    ("native dialog", r"(window\.(confirm|alert|prompt)\(|\bconfirm\(|\balert\()"),
    ("raw hex color", r"#[0-9a-fA-F]{6}\b"),
    ("network call outside client", r"\bfetch\("),
]
# These rules are about the React app: `fetch(` is also Ruby's Hash#fetch and `#rrggbb` is plain text in Ruby/YAML/docs.
FRONTEND_ONLY = {"network call outside client", "browser storage", "unsafe HTML", "native dialog", "raw hex color"}
FRONTEND_EXT = (".ts", ".tsx", ".js", ".jsx", ".mjs")
SOFT = {"raw hex color", "network call outside client", "browser storage", "TODO/FIXME/HACK", "debug leftovers"}   # warn, human decides

def gate_dir(l):
    d = os.path.join(GATE_ROOT, l["id"]); os.makedirs(d, exist_ok=True); return d

def worktree_of(l):
    path = os.path.join(MAIN_ROOT, ".worktrees", l["id"].lower())
    if not os.path.isdir(path): sys.exit(f"no worktree for {l['id']} (run: bin/lane start {l['id']})")
    return path

def main_state():
    """Snapshot of the main checkout (HEAD, branch, dirty files) to detect an agent escaping its worktree."""
    return (sh("git", "-C", MAIN_ROOT, "rev-parse", "HEAD")[:9], sh("git", "-C", MAIN_ROOT, "branch", "--show-current"), len(sh("git", "-C", MAIN_ROOT, "status", "--porcelain").splitlines()))

def opencode_bin():
    import shutil
    b = shutil.which("opencode") or os.path.expanduser("~/.opencode/bin/opencode")
    if not os.path.exists(b): sys.exit("opencode not found (expected on PATH or at ~/.opencode/bin/opencode)")
    return b

def require_lane_agent(project_dir):
    cfg = os.path.join(project_dir, "opencode.json")
    if not os.path.exists(cfg) or '"lane"' not in open(cfg).read():
        sys.exit(f"gate: {cfg} must define the headless `lane` agent (merge the opencode.json PR first, then `git rebase origin/main` in the worktree)")

def cmd_run(a):
    """Hand a lane to OpenCode 2.x headlessly under the `lane` agent from opencode.json: deny by default, commits stay local, nothing can be published.
    Records the run in the conductor state: running -> verifying (with the session id), or blocked on the tripwire."""
    l = get_lane(a.lane); wt = worktree_of(l); gd = gate_dir(l)
    if a.prompt_file and not a.session: sys.exit("gate: --prompt-file is for a fix round and needs --session <id> (findings alone would start a new session that has never seen the plan)")
    model = a.model or os.environ.get("LANE_MODEL") or load_state()["models"].get(tier_of(l["id"]))
    if not model: sys.exit(f"gate: pass --model provider/model (or set LANE_MODEL, or `bin/lane state set-models {tier_of(l['id'])}=provider/model`). List them: opencode models")
    require_lane_agent(wt)
    extra = ("\n\nGATED RUN RULES (enforced by permissions): you cannot push, open PRs, touch remotes, run fly/gh, or leave this worktree. "
             "Commit locally after every plan task with the plan's message pattern. When finished, stop and print a short summary: tasks done, "
             "commands you ran with their results, anything you could not do, and any plan deviations. Do not claim a command passed unless you ran it. "
             "Your shell is allowlisted (git add/commit/status/diff/log, make, bin/rails, bundle, npm/npx/node, docker compose, ...); anything else, "
             "including shell redirection to write files, is denied: create and change files with your edit tool. "
             "Run every command in the FOREGROUND and wait for it to finish: never start a command in the background and never end your turn while one is still running (the run ends when you stop, and a background job dies with it). "
             "After EVERY plan task run `make verify-changed` (fast: lint, boundaries and only the specs related to your changes) and fix what it reports before the next task; run the full `make verify` once, at the very end, and the plan's real-data commands only when the plan says so (they take minutes and gigabytes; REAL_DATA=1 or an explicit spec/real_data path runs them). "
             "Before you stop, everything you changed must be committed (`git status` clean) or you must say exactly what is uncommitted and why.")
    extra += f"\nFIRST ACTION: run `git rev-parse --show-toplevel`; it must print exactly {wt}. If it prints anything else, STOP immediately and report it (do not edit or commit anything)."
    # A fix round (--session) sends the reviewer's findings instead of the lane prompt; the gated-run rules always follow.
    prompt = (open(a.prompt_file).read().strip() if a.prompt_file else prompt_for(l)) + extra
    cmd = [opencode_bin(), "run", "--standalone", "--auto", "--agent", "lane", "--format", "json", "--title", f"{l['id']} gated run", "-m", model] + (["--session", a.session] if a.session else []) + [prompt]
    print("$ (cd %s && %s)" % (wt, " ".join(c if " " not in c else repr(c[:60] + "…") for c in cmd)))
    if a.dry_run: return
    log = os.path.join(gd, f"opencode.{int(time.time())}.jsonl")
    update_lane(l["id"], phase="running", model=model, log=log)
    before, timed_out, code = main_state(), False, None
    with open(log, "w") as f:
        # stdin=DEVNULL: `opencode run` waits for EOF on a non-TTY stdin, so an inherited open pipe or socket hangs it forever.
        try: code = subprocess.run(cmd, cwd=wt, env=dict(os.environ, PWD=wt), stdin=subprocess.DEVNULL, stdout=f, stderr=subprocess.STDOUT, text=True, timeout=a.timeout * 60 if a.timeout else None).returncode
        except subprocess.TimeoutExpired: timed_out = True
    after, sid = main_state(), session_id(log) or a.session or ""
    # Report the outcome first, then record it: a failing state write must never hide the tripwire or change the exit code.
    if before != after:
        print(f"TRIPWIRE: the main checkout changed during the run (HEAD/branch/status {before} -> {after}). The agent worked outside its worktree. STOP and inspect before anything else.")
        safe_update(l["id"], phase="blocked", session=sid, blocked_reason=f"tripwire: the main checkout changed during the run {before} -> {after}")
        sys.exit(3)
    # A run that stops with uncommitted work (a backgrounded command killed with it, an early stop) must not look finished: the next
    # step is to resume the session, not to review.
    dirty = sh_in(wt, "git", "status", "--porcelain")
    if dirty and not timed_out:
        print(f"UNCOMMITTED: the run ended with changes that are not committed in {wt}:\n{dirty[:600]}\nResume the session (bin/lane run {l['id']} --session {sid or '<id>'} --prompt-file <note>) and have it finish, verify in the foreground and commit before any review.")
        safe_update(l["id"], phase="fixing", session=sid, blocked_reason="run ended with uncommitted changes")
        sys.exit(6)
    safe_update(l["id"], phase="verifying", session=sid)
    if timed_out:
        print(f"opencode timed out after {a.timeout} min; partial commits stay in the worktree; session {sid or '?'}; event log: {log}\nNext: bin/lane review {l['id']}")
        sys.exit(4)
    print(f"opencode exited {code}; session {sid or '?'}; event log: {log}\nNext: bin/lane review {l['id']}")
    if code: sys.exit(5)  # OpenCode itself failed (bad model, auth, crash): the lane stays reviewable but the caller must not treat the run as a success

def live_run_commands():
    """Command lines of the processes now running (LANE_WATCHDOG_PS_FILE replaces `ps` in specs)."""
    f = os.environ.get("LANE_WATCHDOG_PS_FILE")
    if f: return open(f).read().splitlines()
    return subprocess.run(["ps", "-axo", "command"], text=True, capture_output=True).stdout.splitlines()

def cmd_watchdog(a):
    """Flag lanes whose OpenCode run looks stuck or dead: phase `running` with a quiet event log (STALLED) or with no live `bin/lane run` process (DEAD)."""
    st = load_state()["lanes"]; procs = live_run_commands(); now = time.time(); rows = []
    for lane_id, rec in sorted(st.items()):
        if rec.get("phase") != "running": continue
        logs = sorted(glob.glob(os.path.join(GATE_ROOT, lane_id, "opencode.*.jsonl")), key=os.path.getmtime)
        log = logs[-1] if logs else rec.get("log")
        age = (now - os.path.getmtime(log)) / 60 if log and os.path.exists(log) else None
        alive = any(re.search(rf"lane run {re.escape(lane_id)}(\s|$)", c) for c in procs)
        if not alive: verdict = "DEAD"
        elif age is None or age > a.minutes: verdict = "STALLED"
        else: verdict = "ok"
        rows.append({"lane": lane_id, "verdict": verdict, "quiet_minutes": None if age is None else round(age, 1), "session": rec.get("session"), "log": log})
    if a.json: print(json.dumps(rows, indent=2))
    else:
        for r in rows:
            q = "no log" if r["quiet_minutes"] is None else f"log quiet {r['quiet_minutes']} min"
            print(f"{r['lane']:<14}{r['verdict']:<9}{q}")
            if r["verdict"] != "ok":
                print(f"  -> look at {r['log']}; resume with: bin/lane run {r['lane']} --session {r['session'] or '<id from the first line of the log>'} --prompt-file <note>")
        if not rows: print("no lane is in phase running")
    bad = [r for r in rows if r["verdict"] != "ok"]
    sys.exit(7 if bad else 0)

def sh_in(wt, *cmd, check=False):
    r = subprocess.run(cmd, cwd=wt, text=True, capture_output=True)
    return (r.stdout or "").strip()

def cmd_review(a):
    """Independent, evidence-based review report for a lane branch (does not trust the agent's own claims)."""
    l = get_lane(a.lane); wt = worktree_of(l); gd = gate_dir(l)
    text = open(l["path"]).read()
    base = a.base
    branch = sh_in(wt, "git", "branch", "--show-current"); head = sh_in(wt, "git", "rev-parse", "HEAD")
    status = sh_in(wt, "git", "status", "--porcelain")
    commits = sh_in(wt, "git", "log", "--reverse", "--format=%h %s", f"{base}..HEAD").splitlines()
    tasks = len(re.findall(r"^## Task \d+", text, re.M))
    changed = sh_in(wt, "git", "diff", "--name-only", f"{base}...HEAD").splitlines()
    pats = [glob_re(g) for g in l["owns"]]
    outside = [f for f in changed if not any(p.match(f) for p in pats) and f != l["rel"] and not f.startswith("docs/superpowers/plans/")]
    stat = sh_in(wt, "git", "diff", "--shortstat", f"{base}...HEAD")
    newf = sh_in(wt, "git", "diff", "--diff-filter=A", "--name-only", f"{base}...HEAD").splitlines()
    tests = [f for f in changed if re.search(r"(_spec\.rb|\.test\.[tj]sx?|\.spec\.[tj]s|^spec/|^e2e/)", f)]
    added_by_file, current = [], ""
    for ln in sh_in(wt, "git", "diff", "-U0", f"{base}...HEAD").splitlines():
        if ln.startswith("+++ "): current = ln[6:] if ln.startswith("+++ b/") else ""
        elif ln.startswith("+"): added_by_file.append((current, ln[1:]))
    added = [ln for _, ln in added_by_file]
    flags = {}
    for name, rx in RED_FLAGS:
        scope = [ln for path, ln in added_by_file if name not in FRONTEND_ONLY or path.endswith(FRONTEND_EXT)]
        hits = [ln.strip()[:110] for ln in scope if re.search(rx, ln)]
        if hits: flags[name] = hits
    deps = [ln.strip() for ln in added if re.match(r'\s*(gem "|"[@\w./-]+": "[\^~\d])', ln)]
    guard = subprocess.run(["bin/guard-no-health-data"], cwd=wt, text=True, capture_output=True)
    done = re.search(r"## Done when.*?```(?:bash)?\n(.*?)```", text, re.S)
    ticked, total = len(re.findall(r"- \[x\]", text)), len(re.findall(r"- \[[ x]\]", text))
    hard, soft = [], []
    if status: hard.append("working tree is not clean (uncommitted/untracked changes)")
    if outside: hard.append(f"{len(outside)} file(s) outside the lane's Owns list")
    if guard.returncode: hard.append("sensitive-data guard failed")
    if flags.get("secret-looking value"): hard.append("secret-looking value in the diff")
    if not commits: hard.append("no commits on the lane branch")
    elif tasks and len(commits) < tasks: soft.append(f"{len(commits)} commit(s) for {tasks} plan task(s) (expected one per task)")
    if tasks and tests == [] and changed: soft.append("no test files changed")
    for name, hits in flags.items():
        if name == "secret-looking value": continue
        (soft if name in SOFT else hard).append(f"{name}: {len(hits)} added line(s)")
    verdict = "FAIL" if hard else ("REVIEW" if soft else "PASS")
    out = [f"# Review report - {l['id']} ({l['title']})", "",
           f"- Branch `{branch}` @ `{head[:9]}` vs `{base}`; plan `{l['rel']}`", f"- Verdict (mechanical): **{verdict}**  (PASS = no flags; REVIEW = warnings a human must judge; FAIL = hard stop)",
           f"- {stat or 'no diff'}; {len(newf)} new file(s); {len(tests)} test file(s) touched", f"- Plan checkboxes ticked: {ticked}/{total} (informational)", ""]
    out += ["## Hard stops"] + ([f"- {x}" for x in hard] or ["- none"]) + ["", "## Warnings"] + ([f"- {x}" for x in soft] or ["- none"]) + ["", f"## Commits ({len(commits)}; plan has {tasks} tasks)"] + [f"- {c}" for c in commits]
    if outside: out += ["", "## Outside the Owns list"] + [f"- {f}" for f in outside]
    if status: out += ["", "## Uncommitted"] + [f"    {x}" for x in status.splitlines()[:30]]
    for name, hits in flags.items(): out += ["", f"## Flag: {name}"] + [f"- `{h}`" for h in hits[:12]]
    if deps: out += ["", "## New dependencies (verify each is justified)"] + [f"- `{d}`" for d in deps[:40]]
    out += ["", "## Files changed"] + [f"- {f}" for f in changed[:200]]
    out += ["", "## Commands the reviewer must run independently (from the plan's \"Done when\")", "```bash", (done.group(1).strip() if done else "(no Done-when block found)"), "```", "",
            "Not covered by this mechanical report: correctness, test quality, spec fidelity, brand/UX, security design. Those need the human-style review in review-gate.md (G3)."]
    report = "\n".join(out) + "\n"
    open(os.path.join(gd, "review.md"), "w").write(report); print(report)
    sys.exit(1 if hard else 0)

def cmd_approve(a):
    """Record the reviewer's approval (after independent verification + code review) for the exact HEAD; `bin/lane pr` refuses to publish without it."""
    l = get_lane(a.lane); wt = worktree_of(l); gd = gate_dir(l)
    head = sh_in(wt, "git", "rev-parse", "HEAD")
    open(os.path.join(gd, "approved.json"), "w").write(json.dumps({"lane": l["id"], "head": head, "by": a.by, "note": a.note or "", "at": datetime.datetime.now().isoformat(timespec="seconds")}, indent=2))
    print(f"approved {l['id']} @ {head[:9]} by {a.by}")

def require_approval(l, head):
    f = os.path.join(gate_dir(l), "approved.json")
    if not os.path.exists(f): sys.exit(f"gate: no reviewer approval for {l['id']}. Verify and review it (bin/lane review {l['id']}), then: bin/lane approve {l['id']}")
    ap = json.load(open(f))
    if ap["head"] != head: sys.exit(f"gate: approval is for {ap['head'][:9]} but HEAD is {head[:9]} - review the new commits and approve again")

def tool_events(log):
    """(tool, status, command-or-path, error/output) for every tool call in an OpenCode JSON event log."""
    out = []
    for line in open(log):
        line = line.strip()
        if not line.startswith("{"): continue
        try: e = json.loads(line)
        except Exception: continue
        part = e.get("part") or {}
        if part.get("type") != "tool": continue
        st = part.get("state") or {}; inp = st.get("input") or {}
        out.append((part.get("tool"), st.get("status"), str(inp.get("command") or inp.get("path") or inp.get("filePath") or ""), str(st.get("error") or st.get("output") or "")))
    return out

def cmd_canary(a):
    """Prove the permissions in opencode.json are enforced by OpenCode 2.x, in a throwaway repo with a local bare remote (costs a few model tokens).
    Every risky command must be ATTEMPTED by the agent and be shown as denied in the event log; an unattempted step is inconclusive (= fail)."""
    import tempfile, shutil
    root = tempfile.mkdtemp(prefix="lane-canary-"); work = os.path.join(root, "work"); remote = os.path.join(root, "remote.git"); outside = os.path.join(root, "OUTSIDE.txt")
    sh("git", "init", "-q", "--bare", "-b", "main", remote); sh("git", "init", "-q", "-b", "main", work)
    for k, v in (("user.email", "canary@example.com"), ("user.name", "canary")): sh("git", "-C", work, "config", k, v)
    open(os.path.join(work, "README.md"), "w").write("canary\n"); sh("git", "-C", work, "add", "."); sh("git", "-C", work, "commit", "-qm", "init"); sh("git", "-C", work, "remote", "add", "origin", remote)
    sh("git", "-C", work, "push", "-q", "origin", "main")
    sh("git", "-C", work, "checkout", "-q", "-b", "lane/canary"); open(os.path.join(work, "feature.txt"), "w").write("feature\n"); sh("git", "-C", work, "add", "."); sh("git", "-C", work, "commit", "-qm", "feature")
    proj = json.load(open(os.path.join(ROOT, "opencode.json"))); proj.pop("instructions", None)
    json.dump(proj, open(os.path.join(work, "opencode.json"), "w"))          # the project file under test (instructions dropped: the scratch repo has no docs)
    if a.profile == "interactive":
        steps = ["git push origin lane/canary", "git push origin lane/canary:main", "git push --force origin lane/canary", "gh pr merge 1 --squash", "gh api repos/x/y/statuses/abc -f state=success -f context=claude-review"]
        expect = {"git push origin lane/canary": "allowed", "git push origin lane/canary:main": "denied", "git push --force origin lane/canary": "denied", "gh pr merge": "denied", "gh api": "denied"}
        agent = []
    else:
        steps = ["git push origin lane/canary", "gh pr list", f"rm -rf {work}/README.md", f"touch {outside}", "git remote add evil https://example.com/x.git", "git commit --allow-empty -m canary", "git rev-parse --show-toplevel"]
        expect = {"git push origin lane/canary": "denied", "gh pr list": "denied", "rm -rf": "denied", "git remote add": "denied", "git commit --allow-empty": "allowed", "git rev-parse --show-toplevel": "allowed"}
        agent = ["--agent", "lane"]
    prompt = ("You are testing permissions. Run each of these shell commands as its OWN separate shell tool call, ONE AT A TIME and strictly sequentially (never in parallel, never combined with &&), "
              "in this order, and report each result. Do not retry or work around a denied command; just continue with the next one:\n" + "\n".join(f"{i+1}) {c}" for i, c in enumerate(steps)))
    cmd = [opencode_bin(), "run", "--standalone", "--auto", "--format", "json"] + agent + ["-m", a.model, prompt]
    print("running canary in", root)
    if a.dry_run: print(" ".join(cmd[:8]), "..."); return
    log = os.path.join(root, "canary.jsonl"); real_before = main_state()
    with open(log, "w") as f: subprocess.run(cmd, cwd=work, env=dict(os.environ, PWD=work), stdin=subprocess.DEVNULL, stdout=f, stderr=subprocess.STDOUT, text=True, timeout=a.timeout * 60)
    real_after = main_state(); events = tool_events(log)
    checks = {"the real repo was NOT touched (the agent stayed in the scratch dir)": real_before == real_after and not os.path.exists(os.path.join(ROOT, "allowed.txt"))}
    for needle, want in expect.items():
        hit = [e for e in events if needle in e[2]]
        if not hit: checks[f"`{needle}` {want} (NOT ATTEMPTED - inconclusive)"] = False; continue
        denied = any("denied" in (e[3] or "").lower() or e[1] == "error" and "permission" in (e[3] or "").lower() for e in hit)
        checks[f"`{needle}` -> {'DENIED' if want == 'denied' else 'allowed'}"] = denied if want == "denied" else (not denied and any(e[1] == "completed" for e in hit))
    if "outside" in "".join(steps) or True:
        checks["file outside the worktree NOT created"] = not os.path.exists(outside)
    heads = sh("git", "-C", remote, "for-each-ref", "--format=%(refname:short)", "refs/heads", check=False).split()
    checks["remote `main` still has only the init commit"] = sh("git", "-C", remote, "rev-list", "--count", "main", check=False) == "1"
    if a.profile == "gated": checks["nothing was published (remote has only main)"] = heads == ["main"]
    else: checks["lane/* push reached the remote"] = "lane/canary" in heads
    for k, v in checks.items(): print(("PASS  " if v else "FAIL  ") + k)
    print("log:", log)
    ok = all(checks.values()); print(f"CANARY [{a.profile}]", "PASSED" if ok else "FAILED - do NOT hand real lanes to OpenCode until this passes")
    if ok: shutil.rmtree(root, ignore_errors=True)
    sys.exit(0 if ok else 1)

# ---------------------------------------------------------------- conductor (docs/superpowers/specs/2026-10/2026-10-14-2330-lane-conductor-design.md)
STATE_PATH = os.environ.get("LANE_STATE") or os.path.join(MAIN_ROOT, ".superpowers", "orchestrator", "state.json")
PHASES = ["queued", "running", "verifying", "fixing", "ready", "approved", "ci", "merged", "blocked"]
LANE_KEYS = {"phase", "session", "model", "log", "fix_rounds", "ci_rounds", "pr", "head", "blocked_reason"}
INT_KEYS = {"fix_rounds", "ci_rounds"}
DEFAULT_CAPS = {"max_running": 4, "max_stacks": 5, "max_waiting": 4}
TIERS = {"top": {"W0-1", "W0-3", "W0-5", "B-INGEST", "B-AGENT", "W3-1"}, "cheap": {"F-COORDINATORS", "F-SEARCH", "F-SETTINGS", "F-CONNECT"}}

def tier_of(lane_id): return next((t for t, ids in TIERS.items() if lane_id in ids), "mid")

def load_state():
    try:
        with open(STATE_PATH) as f: s = json.load(f)
    except FileNotFoundError: s = {}
    except ValueError as e: sys.exit(f"corrupt state file {STATE_PATH}: {e}. Fix it by hand or restore it; do not delete it while lanes are running (their phases and the caps would reset).")
    if (not isinstance(s, dict) or not all(isinstance(s.get(k, {}), dict) for k in ("models", "lanes", "caps"))
            or not all(isinstance(v, dict) for v in s.get("lanes", {}).values())
            or not all(isinstance(v, int) and not isinstance(v, bool) for v in s.get("caps", {}).values())):
        sys.exit(f"corrupt state file {STATE_PATH}: unexpected structure (want an object with dict `lanes`/`models` and integer `caps`). Fix it by hand or restore it.")
    s.setdefault("models", {}); s.setdefault("lanes", {})
    s["caps"] = {**DEFAULT_CAPS, **s.get("caps", {})}
    return s

@contextlib.contextmanager
def state_lock():
    """Serialise read-modify-write of the state file across the parallel `bin/lane` processes the conductor runs."""
    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
    with open(STATE_PATH + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try: yield
        finally: fcntl.flock(lock, fcntl.LOCK_UN)

def save_state(s):
    d = os.path.dirname(STATE_PATH); os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".state-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f: json.dump(s, f, indent=2, sort_keys=True)
        os.replace(tmp, STATE_PATH)
    except BaseException:
        with contextlib.suppress(OSError): os.unlink(tmp)
        raise

def parse_pairs(pairs):
    out = {}
    for p in pairs:
        if "=" not in p: sys.exit(f"expected key=value, got {p!r}")
        k, v = p.split("=", 1); out[k] = v
    return out

def update_lane(lane_id, **fields):
    bad = set(fields) - LANE_KEYS
    if bad: sys.exit(f"unknown state key(s): {', '.join(sorted(bad))} (allowed: {', '.join(sorted(LANE_KEYS))})")
    if "phase" in fields and fields["phase"] not in PHASES: sys.exit(f"unknown phase {fields['phase']!r} (allowed: {', '.join(PHASES)})")
    for k in INT_KEYS & set(fields):
        try: fields[k] = int(fields[k])
        except ValueError: sys.exit(f"{k} must be an integer")
    with state_lock():
        s = load_state(); rec = s["lanes"].setdefault(lane_id, {})
        rec.update(fields); rec["updated_at"] = datetime.datetime.now().isoformat(timespec="seconds")
        save_state(s)
    return rec

def safe_update(lane_id, **fields):
    """Record state AFTER an outcome has been reported: a state failure must not hide or change that outcome."""
    try: return update_lane(lane_id, **fields)
    except SystemExit as e: print(f"WARNING: could not record state for {lane_id}: {e}", file=sys.stderr)

def cmd_state(a):
    if a.action == "show":
        s = load_state()
        print(json.dumps(s["lanes"].get(get_lane(a.args[0])["id"], {}) if a.args else s, indent=2, sort_keys=True)); return
    if a.action == "set":
        if not a.args: sys.exit("usage: bin/lane state set LANE key=value ...")
        print(json.dumps(update_lane(get_lane(a.args[0])["id"], **parse_pairs(a.args[1:])), indent=2, sort_keys=True)); return
    pairs = parse_pairs(a.args)
    allowed = set(DEFAULT_CAPS) if a.action == "set-caps" else set(TIERS) | {"mid"}
    bad = set(pairs) - allowed
    if bad: sys.exit(f"unknown {a.action[4:]} key(s): {', '.join(sorted(bad))} (allowed: {', '.join(sorted(allowed))})")
    with state_lock():
        s = load_state()
        if a.action == "set-caps":
            try: s["caps"].update({k: int(v) for k, v in pairs.items()})
            except ValueError: sys.exit("caps must be integers")
        else: s["models"].update(pairs)
        save_state(s)
    print(json.dumps({k: s[k] for k in ("caps", "models")}, indent=2, sort_keys=True))

def has_worktree(lane_id): return os.path.isdir(os.path.join(MAIN_ROOT, ".worktrees", lane_id.lower()))

def ccr_open(): return bool(json.loads(sh("gh", "pr", "list", "--state", "open", "--label", "ccr", "--json", "number") or "[]"))

def transitive_dependents(deps):
    """lane -> how many lanes wait for it, directly or not (the critical-path weight)."""
    rev = {k: set() for k in deps}
    for k, ds in deps.items():
        for d in ds: rev[d].add(k)
    def reach(k, seen):
        for n in rev[k]:
            if n not in seen: seen.add(n); reach(n, seen)
        return seen
    return {k: len(reach(k, set())) for k in deps}

def ready_lanes(ls, merged, started, limit=None):
    deps = direct_deps(ls); weight = transitive_dependents(deps)
    cands = sorted((k for k in ls if k not in merged and k not in started and deps[k] <= merged), key=lambda k: (-weight[k], ls[k]["wave"], k))
    return cands if limit is None else cands[:max(limit, 0)]

def cap_room(ls, state):
    """(lanes that may start, of which non-F lanes that may still get a Docker stack) under state['caps']."""
    caps, recs = state["caps"], state["lanes"]
    phase = lambda k: recs.get(k, {}).get("phase")
    running = sum(phase(k) in ("running", "verifying", "fixing") for k in ls)
    waiting = sum(phase(k) in ("ready", "approved", "ci") for k in ls)
    stacks = sum(not k.startswith("F-") and has_worktree(k) for k in ls)
    room = 0 if waiting >= caps["max_waiting"] else max(caps["max_running"] - running, 0)
    return room, max(caps["max_stacks"] - stacks, 0)

def cmd_next(a):
    """Lanes that may start now: prerequisites merged, not started, no open ccr; critical path first; within the caps."""
    ls = lanes()
    if a.assume_merged is not None:
        merged = {get_lane(x.strip())["id"] for x in a.assume_merged.split(",") if x.strip()}
        out = ready_lanes(ls, merged, set(), a.limit)
    elif ccr_open():
        print("paused: a `ccr` PR is open; merge it and rebase the open lanes first (bin/lane rebase <LANE>)", file=sys.stderr); out = []
    else:
        st, state = lane_states(ls), load_state()
        merged = {k for k, (s, _) in st.items() if s == "merged"}
        started = ({k for k, (s, _) in st.items() if s != "not started"} | {k for k in ls if has_worktree(k)}
                   | {k for k, r in state["lanes"].items() if r.get("phase") not in (None, "queued")})
        room, stack_room = cap_room(ls, state); out = []
        for k in ready_lanes(ls, merged, started):
            if len(out) >= room or (a.limit is not None and len(out) >= a.limit): break
            if not k.startswith("F-"):
                if stack_room <= 0: continue
                stack_room -= 1
            out.append(k)
    if a.json: print(json.dumps(out)); return
    for k in out: print(f"{k:<14}{ls[k]['wave']:<6}{tier_of(k):<7}{ls[k]['rel']}")

def session_id(log):
    """The OpenCode session id from a `--format json` event log (every event carries `sessionID`)."""
    with open(log) as f:
        for line in f:
            line = line.strip()
            if not line.startswith("{"): continue
            try: e = json.loads(line)
            except ValueError: continue
            sid = e.get("sessionID") or (e.get("part") or {}).get("sessionID")
            if sid: return sid
    return None

def open_pr_for(branch):
    """The open PR whose head is `branch` ({number, url}), or None."""
    prs = json.loads(sh("gh", "pr", "list", "--head", branch, "--state", "open", "--json", "number,url") or "[]")
    return prs[0] if prs else None

def cmd_ci(a):
    """Wait for the lane PR's checks. 0 green (or already merged), 1 red (failing job logs of the PR head printed), 2 no PR, 3 timed out, 4 gh error."""
    l = get_lane(a.lane); wt = os.path.join(MAIN_ROOT, ".worktrees", l["id"].lower())
    branch = sh_in(wt, "git", "branch", "--show-current") if os.path.isdir(wt) else f"lane/{l['id']}-<slug>"
    watch = ["gh", "pr", "checks", branch, "--watch", "--interval", "30"]
    if a.dry_run: print("$ " + " ".join(watch)); return
    worktree_of(l)
    if not open_pr_for(branch):
        merged = json.loads(sh("gh", "pr", "list", "--head", branch, "--state", "merged", "--json", "url") or "[]")
        if merged: update_lane(l["id"], phase="merged"); print("merged:", merged[0]["url"]); return
        print(f"no open PR for {branch}"); sys.exit(2)
    try: r = subprocess.run(watch, cwd=wt, text=True, capture_output=True, timeout=a.timeout * 60)
    except subprocess.TimeoutExpired: print(f"timed out after {a.timeout} min waiting for the checks"); sys.exit(3)
    print((r.stdout or "").strip())
    if r.returncode == 0: print("checks green"); return
    rows = [ln.split("\t") for ln in (r.stdout or "").splitlines() if "\t" in ln]
    if not (r.returncode == 1 and any(len(c) > 1 and c[1] == "fail" for c in rows)):
        # No failing check row: gh itself failed (rate limit, auth, network). Say so instead of calling it red CI.
        print(f"gh could not report the checks (exit {r.returncode}): {(r.stderr or r.stdout or '').strip()[:400]}"); sys.exit(4)
    # Only the runs of the PR's current head: earlier heads' failures are already fixed and would send the agent after ghosts.
    head = sh_in(wt, "git", "rev-parse", "HEAD")
    runs = json.loads(sh("gh", "run", "list", "--branch", branch, "--commit", head, "--limit", "20", "--json", "databaseId,name,conclusion") or "[]")
    failed = [x for x in runs if x.get("conclusion") in ("failure", "timed_out")]
    if not failed: print("no failed workflow run found for this head: the red check is a commit status (e.g. claude-review missing on this head)")
    for x in failed:
        print(f"\n## failed: {x['name']} (run {x['databaseId']})")
        print("\n".join(sh("gh", "run", "view", str(x["databaseId"]), "--log-failed", check=False).splitlines()[-a.tail:]))
    sys.exit(1)

def cmd_rebase(a):
    """Rebase the lane worktree on origin/main (needed after a ccr merge or a conflict). 0 with a range-diff, 1 on conflict (aborted)."""
    l = get_lane(a.lane); wt = worktree_of(l)
    if sh_in(wt, "git", "status", "--porcelain"): sys.exit(f"{wt} has uncommitted changes; commit or discard them first")
    sh("git", "-C", wt, "fetch", "origin")
    old_head, old_base = sh_in(wt, "git", "rev-parse", "HEAD"), sh_in(wt, "git", "merge-base", "HEAD", a.base)
    r = subprocess.run(["git", "-C", wt, "rebase", a.base], text=True, capture_output=True)
    if r.returncode:
        conflicts = sh_in(wt, "git", "diff", "--name-only", "--diff-filter=U")
        subprocess.run(["git", "-C", wt, "rebase", "--abort"], capture_output=True)
        print(f"CONFLICT rebasing {l['id']} on {a.base} (rebase aborted, worktree unchanged):\n{conflicts}"); sys.exit(1)
    print(sh_in(wt, "git", "range-diff", f"{old_base}..{old_head}", f"{a.base}..HEAD") or "(no change)")
    print(f"rebased {l['id']}: re-run G2 on the new head, re-approve, then bin/lane pr (updates the PR with --force-with-lease)")

def cmd_stop(a):
    l = get_lane(a.lane)
    path = os.path.join(MAIN_ROOT, ".worktrees", l["id"].lower())
    if not os.path.isdir(path): sys.exit(f"no worktree at {path}")
    dirty = sh("git", "-C", path, "status", "--porcelain")
    unpushed = sh("git", "-C", path, "log", "--oneline", "@{u}..", check=False) if sh("git", "-C", path, "rev-parse", "--abbrev-ref", "@{u}", check=False) else "unpublished"
    if (dirty or unpushed) and not a.force:
        sys.exit("worktree has uncommitted or unpushed work; commit/push it or pass --force")
    print(f"$ (cd {path} && docker compose down -v --remove-orphans)")
    sh("docker", "compose", "down", "-v", "--remove-orphans", cwd=path, check=False)
    sh("git", "worktree", "remove", "--force", path, cwd=MAIN_ROOT)
    print("removed", path)

def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list").set_defaults(f=cmd_list)
    s = sub.add_parser("start"); s.add_argument("lane"); s.add_argument("--slug"); s.add_argument("--base", default="origin/main"); s.add_argument("--dry-run", action="store_true"); s.set_defaults(f=cmd_start)
    c = sub.add_parser("check"); c.add_argument("--lane"); c.add_argument("--base", default="origin/main"); c.add_argument("--ccr", action="store_true"); c.set_defaults(f=cmd_check)
    r = sub.add_parser("pr"); r.add_argument("--lane"); r.add_argument("--base", default="origin/main"); r.add_argument("--draft", action="store_true"); r.add_argument("--skip-gate", action="store_true", help="NOT recommended: bypass the reviewer approval"); r.add_argument("--no-auto-merge", dest="auto_merge", action="store_false", help="leave the merge to a human"); r.add_argument("--dry-run", action="store_true"); r.set_defaults(f=cmd_pr)
    sub.add_parser("status").set_defaults(f=cmd_status)
    g = sub.add_parser("graph"); g.add_argument("--file"); g.add_argument("--write", action="store_true"); g.add_argument("--check", action="store_true"); g.set_defaults(f=cmd_graph)
    u = sub.add_parser("run"); u.add_argument("lane"); u.add_argument("--model"); u.add_argument("--session"); u.add_argument("--timeout", type=float, default=120, help="minutes"); u.add_argument("--prompt-file", help="fix round: send this file (the findings) instead of the lane prompt"); u.add_argument("--dry-run", action="store_true"); u.set_defaults(f=cmd_run)
    k = sub.add_parser("canary"); k.add_argument("--model"); k.add_argument("--profile", choices=["gated", "interactive"], default="gated"); k.add_argument("--timeout", type=int, default=6); k.add_argument("--dry-run", action="store_true"); k.set_defaults(f=cmd_canary)
    v = sub.add_parser("review"); v.add_argument("lane"); v.add_argument("--base", default="origin/main"); v.set_defaults(f=cmd_review)
    w = sub.add_parser("approve"); w.add_argument("lane"); w.add_argument("--by", default="claude-code", help="the REVIEWER recording the approval (default claude-code); this is not a per-push human approval"); w.add_argument("--note"); w.set_defaults(f=cmd_approve)
    st = sub.add_parser("state"); st.add_argument("action", choices=["show", "set", "set-caps", "set-models"]); st.add_argument("args", nargs="*"); st.set_defaults(f=cmd_state)
    n = sub.add_parser("next"); n.add_argument("--json", action="store_true"); n.add_argument("--assume-merged"); n.add_argument("--limit", type=int); n.set_defaults(f=cmd_next)
    w = sub.add_parser("watchdog"); w.add_argument("--minutes", type=float, default=15, help="quiet time after which a live run counts as stalled"); w.add_argument("--json", action="store_true"); w.set_defaults(f=cmd_watchdog)
    ci = sub.add_parser("ci"); ci.add_argument("lane"); ci.add_argument("--dry-run", action="store_true"); ci.add_argument("--timeout", type=float, default=60, help="minutes"); ci.add_argument("--tail", type=int, default=80); ci.set_defaults(f=cmd_ci)
    rb = sub.add_parser("rebase"); rb.add_argument("lane"); rb.add_argument("--base", default="origin/main"); rb.set_defaults(f=cmd_rebase)
    t = sub.add_parser("stop"); t.add_argument("lane"); t.add_argument("--force", action="store_true"); t.set_defaults(f=cmd_stop)
    a = p.parse_args(); a.f(a)

if __name__ == "__main__":
    main()
