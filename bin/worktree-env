#!/usr/bin/env bash
# Writes this worktree's .env so its Docker stack cannot touch another checkout's:
# own compose project (containers, network, volumes), own databases, and host ports
# left to Docker (no fixed 3000/3036/5434 to collide on). It also points SIMBE_EXPORTS_DIR at the main
# checkout's local-only exports (git-ignored, so linked worktrees don't contain them). Run once per linked worktree:
#   make worktree-env      (or it is run for you by `bin/lane start`)
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
common="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
main_root="$(dirname "$common")"

if [ "$root" = "$main_root" ]; then
  echo "This is the main checkout; worktree-env is for linked worktrees only." >&2
  exit 1
fi

name="$(basename "$root")"
slug="$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-' | sed 's/-*$//')"
db="simbe_wt_$(echo "$slug" | tr '-' '_')"

if [ ! -f "$main_root/.env" ]; then
  echo "No .env in the main checkout ($main_root); create it from .env.example first." >&2
  exit 1
fi

managed='^(COMPOSE_PROJECT_NAME|POSTGRES_DB|WEB_PORTS|VITE_PORTS|DB_PORTS|SIMBE_EXPORTS_DIR)='
{
  grep -Ev "$managed" "$main_root/.env" || true
  cat <<VARS
COMPOSE_PROJECT_NAME=simbe-wt-$slug
POSTGRES_DB=$db
WEB_PORTS=3000
VITE_PORTS=3036
DB_PORTS=5432
SIMBE_EXPORTS_DIR=$main_root/handoff/takehome/exports
VARS
} > "$root/.env"

echo "Wrote $root/.env"
echo "  compose project: simbe-wt-$slug"
echo "  database:        $db"
echo "  host ports:      assigned by Docker (see \`make ports\` once the stack is up)"
