#!/usr/bin/env python3
"""CI parity: every CI command that gates a merge must also run in `make verify`, with the same strictness.

The pipeline's rule (spec `2200`, decision 9) is "local = CI": a command a CI job runs must be
part of `make verify`, so an agent that passes `make verify` passes CI except the
environment-only jobs (`docker_build`, `deploy`, `e2e_real`).

Rules enforced:
  1. Every `run:` step in `.github/workflows/ci.yml` must carry a marker, on the `run:` line or on
     the step's `name:` line: `# parity` (also part of `make verify`) or `# ci-only` (setup,
     environment-only or reporting steps). An unmarked step FAILS, so a new CI check cannot
     silently escape the local gate.
  2. Each `# parity` command is reduced to check ids (see ``CHECKS``) and the id must appear in
     `make -n verify` (plus one level of `make` recursion).
  3. Strictness must agree: for checks whose flags change what passes (``STRICT_FLAGS``, e.g.
     `npm audit --omit=dev --audit-level=high`), the CI command and a local command for the same
     check must carry the same flag set. Phrasing that does not change strictness
     (`rubocop --format github`, `parallel_rspec`) is ignored.
  4. `.ruby-version` equals the Ruby tag of the Dockerfile's base image.

Exits non-zero on any violation. Run it from anywhere in the repo; ``--workflow PATH`` checks
another file (used by the specs).
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys

# The repo root is the parent of bin/ (no git needed: the specs run this inside the Docker image).
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_WORKFLOW = os.path.join(ROOT, ".github", "workflows", "ci.yml")
DOCKERFILE = os.path.join(ROOT, "Dockerfile")
RUBY_VERSION = os.path.join(ROOT, ".ruby-version")

# check id -> regex matching either the CI or the local phrasing of that check
CHECKS: list[tuple[str, str]] = [
    ("contract-bundle-and-lint", r"\bnpm run contract\b"),
    ("contract-types-up-to-date", r"\bnpm run types\b"),
    ("contract-coverage", r"contract:coverage|contract-coverage"),
    ("lane-ownership-overlap", r"check-ownership\.sh"),
    ("brakeman", r"\bbrakeman\b"),
    ("bundler-audit", r"\bbundler-audit\b"),
    ("npm-audit", r"\bnpm audit\b"),
    ("knip", r"\bknip\b"),
    ("rubocop", r"\brubocop\b"),
    ("boundaries-check", r"boundaries:check"),
    ("eslint", r"\bnpm run lint\b|\beslint\b"),
    ("typescript", r"\bnpm run typecheck\b|\btsc\b"),
    ("rspec", r"\brspec\b|\bparallel_rspec\b"),
    ("vitest", r"\bnpm test\b|\bvitest\b"),
    ("playwright-mock", r"\bplaywright\b"),
    ("guard-no-health-data", r"guard-no-health-data"),
    ("golden-json-valid", r"golden\.json"),
    ("lane-tooling-loads", r"\blane list\b"),
]

# Flags that change what a check lets through; CI and local must agree on them.
STRICT_FLAGS: dict[str, list[str]] = {
    "npm-audit": [r"--omit=\w+", r"--audit-level=\w+", r"--production\b"],
    "brakeman": [r"-q\b", r"--no-pager", r"--no-exit-on-warn", r"--no-exit-on-error"],
    "bundler-audit": [r"--update", r"--ignore\b"],
    "rubocop": [r"--only\b", r"--except\b"],
    "playwright-mock": [r"--grep\S*", r"--project\S*"],
}

MARKER = re.compile(r"#\s*(parity|ci-only)\s*$")
BLOCK = ("|", ">", "|-", ">-", "|+", ">+")


def detect(text: str) -> set[str]:
    return {cid for cid, pat in CHECKS if re.search(pat, text)}


def signatures(command_lines: list[str]) -> dict[str, set[frozenset[str]]]:
    """check id -> the flag sets (one per command line) that mention it."""
    result: dict[str, set[frozenset[str]]] = {}
    for line in command_lines:
        for cid in detect(line):
            flags = frozenset(m for pat in STRICT_FLAGS.get(cid, []) for m in re.findall(pat, line))
            result.setdefault(cid, set()).add(flags)
    return result


def split_steps(text: str) -> list[list[str]]:
    """The workflow's `- ...` list items that contain a `run:`; each is its list of lines."""
    lines = text.splitlines()
    steps: list[list[str]] = []
    i, n = 0, len(lines)
    while i < n:
        m = re.match(r"^(\s*)- ", lines[i])
        if not m:
            i += 1
            continue
        indent = len(m.group(1))
        j = i + 1
        while j < n and (lines[j].strip() == "" or len(lines[j]) - len(lines[j].lstrip()) > indent):
            j += 1
        steps.append(lines[i:j])
        i = j if j > i + 1 else i + 1
    return [s for s in steps if any(re.match(r"^\s*(?:-\s*)?run:", line) for line in s)]


def step_command(step: list[str]) -> str:
    for idx, line in enumerate(step):
        m = re.match(r"^(\s*)(?:-\s*)?run:\s*(.*)$", line)
        if not m:
            continue
        base = len(line) - len(line.lstrip())
        rest = re.sub(r"\s+#\s*(parity|ci-only)\s*$", "", m.group(2)).strip()
        if rest not in BLOCK:
            return rest
        block = []
        for nxt in step[idx + 1 :]:
            if nxt.strip() == "" or len(nxt) - len(nxt.lstrip()) > base:
                block.append(nxt.strip())
            else:
                break
        return "\n".join(block)
    return ""


def classify(text: str) -> tuple[list[str], list[str]]:
    """(parity commands, descriptions of unmarked run steps)."""
    parity: list[str] = []
    unmarked: list[str] = []
    for step in split_steps(text):
        marks = {m.group(1) for line in step if (m := MARKER.search(line))}
        command = step_command(step)
        if not marks:
            first = next((ln.strip() for ln in command.splitlines() if ln.strip()), "(empty)")
            unmarked.append(first[:80])
        elif "parity" in marks:
            parity.append(command)
    return parity, unmarked


def make_dry(target: str) -> str:
    proc = subprocess.run(["make", "-n", target], cwd=ROOT, capture_output=True, text=True)
    if proc.returncode != 0:
        print(f"make -n {target} failed:\n{proc.stdout}{proc.stderr}", file=sys.stderr)
        sys.exit(1)
    return proc.stdout + proc.stderr


def verify_text() -> str:
    text = make_dry("verify")
    seen: set[str] = set()
    for target in re.findall(r"(?:^|\s)(?:\S*/)?make ([\w-]+)", text):
        if target != "verify" and target not in seen:
            seen.add(target)
            text += "\n" + make_dry(target)
    return text


def ruby_version_problems() -> list[str]:
    declared = open(RUBY_VERSION).read().strip().removeprefix("ruby-")  # e.g. 3.4.11
    from_line = re.search(r"^FROM\s+\S*ruby:([\d.]+)", open(DOCKERFILE).read(), re.M)
    got = from_line.group(1) if from_line else "(no ruby base image)"
    if declared != got:
        return [f"Dockerfile base image ruby:{got} does not match .ruby-version {declared}"]
    return []


def problems_for(workflow_text: str, local_text: str) -> tuple[list[str], list[str]]:
    """(problems, parity commands) for a workflow and the text of `make -n verify`."""
    parity, unmarked = classify(workflow_text)
    problems = [f"CI step has no `# parity` or `# ci-only` marker: {u}" for u in unmarked]

    ci_lines = [ln for cmd in parity for ln in cmd.splitlines() if ln.strip()]
    local_lines = [ln for ln in local_text.splitlines() if ln.strip()]
    ci_sigs, local_sigs = signatures(ci_lines), signatures(local_lines)
    for cid in sorted(ci_sigs):
        if cid not in local_sigs:
            problems.append(f"'{cid}' is in CI (marked # parity) but not in `make verify`")
            continue
        for flags in ci_sigs[cid]:
            if flags not in local_sigs[cid]:
                have = sorted(sorted(s) for s in local_sigs[cid])
                problems.append(f"'{cid}' runs with {sorted(flags)} in CI but with {have} in `make verify`")
    return problems, parity


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--workflow", default=DEFAULT_WORKFLOW)
    args = parser.parse_args()

    problems, parity = problems_for(open(args.workflow).read(), verify_text())
    problems += ruby_version_problems()

    print(f"parity steps checked: {len(parity)}")
    for cmd in parity:
        one = " ; ".join(line.strip() for line in cmd.splitlines() if line.strip())
        print(f"  {sorted(detect(cmd)) or '(none)'}  <-  {one}")

    if problems:
        print("\nCI parity FAILED:", file=sys.stderr)
        for p in problems:
            print(f"  - {p}", file=sys.stderr)
        return 1
    print("\nCI parity ok: every run step is marked and every # parity step is in `make verify` with the same flags.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
