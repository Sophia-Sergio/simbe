{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/conventions/*.md",
    "docs/design/brand.md",
    "docs/superpowers/parallel/README.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "make *": "allow",
      "bin/lane check*": "allow",
      "bin/lane status*": "allow",
      "bin/lane list*": "allow",
      "bin/guard-no-health-data*": "allow",
      "bin/golden-numbers*": "allow",
      "bundle *": "allow",
      "bin/rails *": "allow",
      "bin/rake *": "allow",
      "bin/vite *": "allow",
      "bin/rubocop*": "allow",
      "bin/brakeman*": "allow",
      "docker compose *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "python3 *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "mkdir *": "allow",
      "curl *localhost*": "allow",
      "curl *127.0.0.1*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git mv*": "allow",
      "git rm*": "allow",
      "git checkout -b *": "allow",
      "gh *": "ask",
      "gh pr create*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr checks*": "allow",
      "gh pr status*": "allow",
      "git push*": "deny",
      "git push origin lane/*": "allow",
      "git push -u origin lane/*": "allow",
      "git push origin HEAD:refs/heads/lane/*": "allow",
      "git push*:*": "deny",
      "git push*--force*": "deny",
      "git push* -f*": "deny",
      "git push*--delete*": "deny",
      "git push*--mirror*": "deny",
      "git push*--all*": "deny",
      "git push*--tags*": "deny",
      "git remote*": "deny",
      "git config*": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "git branch -D*": "deny",
      "git branch -d*": "deny",
      "gh pr merge*": "deny",
      "gh pr review*": "deny",
      "gh api*": "deny",
      "gh repo*": "deny",
      "gh workflow*": "deny",
      "gh secret*": "deny",
      "gh release*": "deny",
      "fly*": "deny",
      "flyctl*": "deny",
      "sudo*": "deny",
      "rm -rf *": "deny",
      "docker system prune*": "deny",
      "docker volume rm*": "ask",
      "docker compose down -v*": "deny",
      "docker compose -p *": "deny"
    }
  },
  "agent": {
    "lane": {
      "description": "Headless lane implementer (gated by Claude Code review). Can edit and commit locally; cannot publish.",
      "permission": {
        "edit": "allow",
        "external_directory": "deny",
        "bash": {
          "*": "deny",
          "make *": "allow",
          "bin/lane check*": "allow",
          "bin/lane status*": "allow",
          "bin/lane list*": "allow",
          "bin/guard-no-health-data*": "allow",
          "bin/golden-numbers*": "allow",
          "bundle *": "allow",
          "bin/rails *": "allow",
          "bin/rake *": "allow",
          "bin/vite *": "allow",
          "bin/rubocop*": "allow",
          "bin/brakeman*": "allow",
          "docker compose *": "allow",
          "npm *": "allow",
          "npx *": "allow",
          "node *": "allow",
          "python3 *": "allow",
          "ls*": "allow",
          "cat *": "allow",
          "mkdir *": "allow",
          "curl *localhost*": "allow",
          "curl *127.0.0.1*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git add*": "allow",
          "git commit*": "allow",
          "git mv*": "allow",
          "git rm*": "allow",
          "git checkout -b *": "allow",
          "git push*": "deny",
          "git remote*": "deny",
          "gh *": "deny",
          "fly*": "deny",
          "flyctl*": "deny",
          "sudo*": "deny",
          "rm -rf *": "deny"
        }
      }
    }
  }
}
