.DS_Store
.env
.env.*
!.env.example
# Sensitive: fictional health data, never commit exports (take-home ground rule)
handoff/takehome/exports/*/
# Generated OpenAPI bundle (rebuilt by `make contract`)
contracts/dist/
/node_modules
/log
/tmp
/storage
/coverage
.worktrees/
.claude/worktrees/
.superpowers/
.lane-prompt.md

# Vite Ruby
/public/vite*
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vite.dev/guide/env-and-mode.html#env-files
*.local

# Rails generated
.byebug_history
config/master.key


# Playwright
/e2e/screenshots
/e2e/test-results
/playwright-report

# route probes written by specs; a killed run must not leave one behind in git
app/packs/*/config/routes/zz_probe.rb
app/packs/*/config/routes_root/zz_probe.rb

# Generated sample exports (fictional; `bin/generate-sample-export --errors`)
/db/sample_exports/
