{
  "name": "simbe",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "bin/vite dev",
    "dev:mock": "vite --config vite.mock.config.ts --port ${E2E_MOCK_PORT:-5173} --host 127.0.0.1",
    "build": "bin/vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app/javascript e2e --no-error-on-unmatched-pattern",
    "contract": "redocly bundle contracts/openapi/openapi.yaml -o contracts/dist/openapi.bundled.yaml && redocly lint contracts/dist/openapi.bundled.yaml --config contracts/.redocly.yaml",
    "types": "npm run contract && openapi-typescript contracts/dist/openapi.bundled.yaml -o app/javascript/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "^1.34.21",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "msw": "2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.30",
    "tailwindcss": "3.4",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-ruby": "^5.2.5",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@faker-js/faker": "10.6.0"
  }
}
